{UTF-8}
BASE HARVEST=9667
	~	t/Month
	~		|

DISPATCH CAPACITY=10000
	~	t/Month
	~		|

Dispatch Limit=MIN( Finished Goods Inventory / DISPATCH TIME , DISPATCH CAPACITY )
	~	t/Month
	~		|

DISPATCH TIME=0.25
	~	Month
	~		|

DOMESTIC DEMAND=1933
	~	t/Month
	~		|

domestic sales=Max Shipments*Domestic Share
	~	t/Month
	~		|

Domestic Share= IF THEN ELSE( Total Demand > 0 , DOMESTIC DEMAND / Total Demand , 0 )
	~	Dmnl
	~		|

export deliveries=Export Pipeline/SHIPPING LEAD TIME
	~	t/Month
	~		|

EXPORT DEMAND=7734
	~	t/Month
	~		|

Export Pipeline= INTEG (export shipments-export deliveries,
		0)
	~	t
	~		|

export shipments=Max Shipments * ( 1 - Domestic Share )
	~	t/Month
	~		|

farm dispatch to processing= MIN( PROCESSING CAPACITY , Farm Inventory / HANDLING TIME\
		 )
	~	t/Month
	~		|

Farm Inventory= INTEG (harvest-farm dispatch to processing-Farm Spoilage,
		INITIAL FARM INVENTORY)
	~	t
	~		|

Farm Spoilage=Farm Inventory*FARM SPOILAGE FRACTION
	~	t/Month
	~		|

FARM SPOILAGE FRACTION=0.015
	~	1/Month
	~		|

Finished Goods Inventory= INTEG (processing completion -domestic sales-export shipments\
		-warehouse spoilage,
		0)
	~	t
	~		|

HANDLING TIME=0.25
	~	Month
	~		|

harvest=BASE HARVEST
	~	t/Month
	~		|

INITIAL FARM INVENTORY=15000
	~	t
	~		|

Max Shipments=MIN ( Dispatch Limit , Total Demand )
	~	t/Month
	~		|

PROCESSING CAPACITY=8000
	~	t/Month
	~		|

processing completion=Processor WIP/Processing Lead Time
	~	t/Month
	~		|

Processing Lead Time=1
	~	Month
	~		|

Processor WIP= INTEG (farm dispatch to processing-processing completion-WIP Spoilage,
		0)
	~	t
	~		|

SHIPPING LEAD TIME=1
	~	Month
	~		|

Total Demand=DOMESTIC DEMAND+EXPORT DEMAND
	~	t/Month
	~		|

Total Shipments=domestic sales+export shipments
	~	t/Month
	~		|

warehouse spoilage=WAREHOUSE SPOILAGE FRACTION*Finished Goods Inventory
	~	t/Month
	~		|

WAREHOUSE SPOILAGE FRACTION=0.005
	~	1/Month
	~		|

WIP Spoilage=Processor WIP*WIP SPOILAGE FRACTION
	~	t/Month
	~		|

WIP SPOILAGE FRACTION=0.005
	~	1/Month
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 60
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	Month [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
